{
  "manifest_version": 3,
  "name": "Factory Edge Commander",
  "version": "0.1.0",
  "description": "通用悬浮命令窗：在任意 Edge 页面输入 /status /audit /probe /goto /click /capture 等，动作在本机执行。白名单，不执行任意代码。",
  "permissions": ["activeTab"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8791/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
